{
  "name": "snam",
  "version": "1.0.0",
  "private": true,
  "description": "This is my first React-Antd project",
  "scripts": {
    "start": "cross-env UMI_ENV=dev max dev",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider max_old_space_size=4096 ANALYZE=1 max build"
  },
  "lint-staged": {
    "**/*.less": "stylelint --syntax less",
    "**/*.{js,jsx,ts,tsx}": "npm run lint-staged:js",
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/pro-layout": "^7.21.8",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.2",
    "@ifrog/uflow": "1.1.0",
    "@umijs/max": "^4.3.41",
    "@uiw/react-amap": "^7.1.13",
    "@uiw/react-codemirror": "^4.23.10",
    "ag-grid-community": "^32.3.3",
    "ag-grid-react": "^32.3.3",
    "antd": "^6.2.1",
    "antd-button-color": "^1.0.4",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "immer": "^10.1.1",
    "immutability-helper": "^3.1.1",
    "js-md5": "^0.8.3",
    "lodash": "^4.17.21",
    "lscache": "^1.3.2",
    "moment": "^2.30.1",
    "object-assign": "^4.1.1",
    "observable-hooks": "^4.2.4",
    "pubsub-js": "^1.9.4",
    "ramda": "^0.30.1",
    "react": "^18.3.1",
    "react-activation": "^0.12.4",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-loops": "^1.3.0",
    "rxjs": "^7.8.1",
    "string-random": "^0.1.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@umijs/fabric": "^4.0.1",
    "@umijs/lint": "^4.3.41",
    "carlo": "^0.9.46",
    "cross-env": "^7.0.3",
    "cross-port-killer": "^1.4.0",
    "detect-installer": "^1.0.2",
    "lint-staged": "^15.2.11",
    "mockjs": "^1.1.0",
    "puppeteer-core": "^23.11.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "checkFiles": [
    "src/**/*.js*",
    "src/**/*.ts*",
    "src/**/*.less",
    "config/**/*.js*",
    "scripts/**/*.js"
  ]
}
